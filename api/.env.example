# Copy to api/.env (gitignored). Local defaults work against `supabase start` without edits.

APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SESSION_SECRET=dev-only-session-secret-change-me
PLATFORM_FEE_BPS=300

# From `pnpm exec supabase status`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Staff API auth (/staff/*) verifies Supabase access tokens: HS256 with this secret, or
# ES256/RS256 via SUPABASE_URL's JWKS endpoint when the local stack signs asymmetrically.
SUPABASE_JWT_SECRET=

# Stripe test mode (needed from M3)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=

# Phase 2 only (AI waiter)
# OPENAI_API_KEY=
