# Copy to web/.env.local (gitignored).

# From `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe test mode (needed from M3)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Where the Next.js /api/* rewrite forwards to (server-side only)
API_INTERNAL_URL=http://127.0.0.1:8000

# Phase 2 only: set to 1 to mount the AI waiter chat drawer
# NEXT_PUBLIC_FEATURE_CHAT=
