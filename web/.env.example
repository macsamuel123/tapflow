# Copy to web/.env.local (gitignored).

# true: sign-up and dashboard run on src/mocks with no API calls (S0, Vercel previews)
NEXT_PUBLIC_DEMO_MODE=false

# true: Demo Brewery and Demo Food Truck share orders across devices (S0.3). Needs the three
# Supabase values for a project with supabase/demo/*.sql applied.
NEXT_PUBLIC_DEMO_CLOUD=false
# Server only. Never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_ADMIN_SECRET=
CRON_SECRET=

# From `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe test mode (needed from M3)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Where the Next.js /api/* rewrite forwards to (server-side only)
API_INTERNAL_URL=http://127.0.0.1:8000

# Phase 2 only: set to 1 to mount the AI waiter chat drawer
# NEXT_PUBLIC_FEATURE_CHAT=
